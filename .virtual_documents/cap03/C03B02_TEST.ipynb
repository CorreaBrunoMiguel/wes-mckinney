# Dados
a = {1, 2, 3, 4}
b = {3, 4, 5}





print(f"União: {a | b}")
print(f"Interseção: {a & b}")
print(f"Diferença: {a - b}")





print(f"Diferença simétrica: {a ^ b}")





# dada
nums = [1, 2, 3, 4, 5, 6]





[n**2 for n in nums if n % 2 == 0]





{n % 3 for n in nums}





{n: n * n for n in nums if n % 2 != 0}





