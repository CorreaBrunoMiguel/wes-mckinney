d2





# Dado
d = {"a": 1, "b": 2, "c": 3}





for k, v in d.items():
    print(f"{k}={v}")





print("Iterar pelas chaves usando .keys()")
for k in list(d.keys()):
    print(k)

print("Iterar pelos valores usando d.values()")
for v in list(d.values()):
    print(v)





# Dada
words = ["ana", "amor", "bola", "banda", "casa"]





g = {}
for word in words:
    g.setdefault(word[0], []).append(word)

print(g)





from collections import defaultdict

g = defaultdict(list)
for word in words:
    g[word[0]].append(word)
print(g)  # tipo defaultdict
print(dict(g))  # tipo dict





