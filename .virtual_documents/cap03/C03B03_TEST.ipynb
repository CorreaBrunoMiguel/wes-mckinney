# Q6)
def power(base, exp):
    return base**exp


# 1)
square = partial(power, exp=2)
cube = partial(power, exp=3)


# 2)
square(5)


# 2)
cube(4)





# Q7)
def evens(n):
    for num in range(n + 1):
        if num % 2 == 0:
            yield num


list(evens(10))


# Q7)
for x in evens(10):
    if x > 6:
        print(x)
        break





