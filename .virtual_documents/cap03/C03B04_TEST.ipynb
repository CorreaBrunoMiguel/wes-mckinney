


# imports
from pathlib import Path


# verificação arquivo "data/segismundo.txt"

segismundo = Path("data/segismundo.txt")

if segismundo.exists():
    print("O arquivo existe!")
else:
    print("O arquivo não foi encontrado.")





# Q3)
def count_lines(path):
    lines = 0
    with open(path) as f:
        for line in f:
            lines += 1
    return lines


count_lines(segismundo)





