# Q6)
a = [1, 2, 2, 3, 5]
b = [2, 4, 4, 5, 6]

A = set(a)
A


B = set(b)
B


# União
uniao = A.union(b)
uniao


# Interseção
intersecao = A.intersection(b)
intersecao


# Diferença
diferenca = A.difference(B)
diferenca


# Diferença Simétrica
diferenca_simetrica = A ^ B
diferenca_simetrica





